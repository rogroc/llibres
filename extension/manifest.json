{
  "manifest_version": 3,
  "permissions": [
    "tabs",
    "storage"
  ],
  "name": "Llibreviu Sync Connector",
  "version": "1.0",
  "description": "Sincronitza i injecta automàticament les dades dels llibres cercats al formulari de la intranet de Llibreviu.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:8080/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}